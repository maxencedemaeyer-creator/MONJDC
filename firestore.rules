rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permet la lecture et l'écriture pour les collections de MonJDC
    match /jdc_entries/{docId} {
      allow read, write: if true;
    }
    match /students/{docId} {
      allow read, write: if true;
    }
    match /evaluations/{docId} {
      allow read, write: if true;
    }
    match /schedule/{docId} {
      allow read, write: if true;
    }
    match /notes/{docId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
